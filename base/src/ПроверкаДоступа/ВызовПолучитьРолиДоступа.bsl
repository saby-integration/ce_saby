
Функция МассивРолейДоступаКФункционалу(РольКонфигурации = Неопределено)
	СписокРолей = Новый Массив;
	СписокРолей.Добавить("ПолныеПрава");
	Если ЗначениеЗаполнено(РольКонфигурации) И НЕ ЕстьПрофилиСПравамиРасширения() Тогда
		// ПРи отсутствии групп доступа с ролью ИмяОсновнойРоли() и не пустой Ролью "КАДРОВИКА"
		СписокРолей.Добавить(РольКонфигурации);
	Иначе
		СписокРолей.Добавить(ИмяОсновнойРоли());
	КонецЕсли;
	Возврат СписокРолей;
КонецФункции

