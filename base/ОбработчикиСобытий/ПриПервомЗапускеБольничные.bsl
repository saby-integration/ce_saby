
Функция ПриПервомЗапускеСЭДО(НазваниеПродукта, ВерсияПродукта, ОбщиеНастройки)
	
	// Загружаем действующие МЧД по организациям у которых настроен обмен с СФР
	ИмяМодуля = "Saby_ЭДОСФСС";
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено Тогда
		
		Попытка
			МодульКонфигурации = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
			МодульКонфигурации.ЗагрузитьМЧДСФР();
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

